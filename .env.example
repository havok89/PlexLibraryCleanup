# ==========================================================
# Plex Clean & Curate - Configuration
# ==========================================================

# Port and Hosting
PORT=6064
HOST=0.0.0.0
DATA_DIR=./data

# Security: Plex OAuth Login (Default: true)
# When true, protects the dashboard with "Sign in with Plex" and restricts
# access exclusively to the Plex Media Server owner/admin. Essential for external/reverse-proxy access.
PLEX_AUTH_ENABLED=true

# Safety Dry Run Mode (Default: true)
# When true, deletion requests are simulated and logged without deleting files.
DRY_RUN=true

# ----------------------------------------------------------
# Plex Media Server Configuration
# ----------------------------------------------------------
# Find your Plex Token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here
PLEX_MOVIE_LIBRARIES=Movies
PLEX_TV_LIBRARIES=TV Shows

# ----------------------------------------------------------
# Overseerr / Jellyseerr Configuration (Optional)
# ----------------------------------------------------------
# Used to show who requested each title and filter unwatched requests from others
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=your_overseerr_api_key_here

# ----------------------------------------------------------
# Radarr & Sonarr Configuration (Optional)
# ----------------------------------------------------------
# Used for safe file deletion & unmonitoring to prevent auto-redownloads
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here

SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

# ----------------------------------------------------------
# Discord Webhook Notifications (Optional)
# ----------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
DISCORD_NOTIFY_ON_ADD=true
DISCORD_NOTIFY_REMINDER_DAYS=2
DISCORD_NOTIFY_ON_DELETE=true

# ----------------------------------------------------------
# Cleanup & Collection Automation Settings
# ----------------------------------------------------------
# Toggle whether automated cleanup collections are active on Plex
MOVIES_CLEANUP_ENABLED=true
TV_CLEANUP_ENABLED=false

# Default unwatched threshold in months (Can also be adjusted live in UI)
DEFAULT_UNWATCHED_MONTHS_MOVIES=6
DEFAULT_UNWATCHED_MONTHS_SHOWS=6

# Collection Names as they will appear on Plex
LEAVING_COLLECTION_NAME=Leaving at the end of the month
RECOMMENDED_MOVIES_COLLECTION=Recommended Movies
RECOMMENDED_SHOWS_COLLECTION=Recommended Shows

# Promotion Flags: Automatically publish shelves to Plex TV apps
PROMOTE_TO_HOME=true
PROMOTE_TO_SHARED=true
PROMOTE_TO_RECOMMENDED=true

# Sync schedule: cron format (Default: 3:00 AM daily)
CRON_SCHEDULE=0 3 * * *
